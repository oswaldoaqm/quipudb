# Motor propio de Rikuq, levantado desde la raiz del repositorio en el 8004
# (el 8000 queda para el motor general; ver docs/puertos.md).
QUIPUDB_URL=http://127.0.0.1:8004
QUIPUDB_TIMEOUT_S=60
# El servidor de Rikuq usa 8002; Quipucamayoc conserva 8001.
RIKUQ_WEB_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
