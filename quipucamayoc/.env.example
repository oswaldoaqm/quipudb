# Copia este archivo como quipucamayoc/.env y llena los valores.
# git ignora .env: la clave nunca entra al repositorio.

# API REST del motor (uvicorn engine.api.main:app --port 8000). Con 127.0.0.1 y
# no localhost: en Windows, localhost prueba IPv6 primero y cada peticion
# tarda ~0.8 s mas.
QUIPUDB_API_URL=http://127.0.0.1:8000
# Segundos antes de dar al motor por caido.
QUIPUDB_TIMEOUT_S=30

# Gemini, el LLM que genera las respuestas (ADR 0010).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Reescribe la pregunta como palabras clave en ingles: basta uno rapido.
GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
# Embeddings para la busqueda por significado (#252). gemini-embedding-2 junta
# una lista de textos en un solo vector: no sirve para embeber por lotes.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Si el principal esta saturado (503) o sin cuota (429), se prueban estos en
# orden. Vacio = sin respaldo.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Origenes que pueden llamar al servidor: el de la interfaz de quipucamayoc/web.
QUIPUCAMAYOC_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
